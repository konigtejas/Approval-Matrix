<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One row per submission attempt: the immutable answer to WHY a record routed where it did. Native history answers who and when. Rows are never deleted; the Lock_Decision_Log validation rule freezes them (arch doc 3.3, 8).</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Approval Decision Log</label>
    <nameField>
        <displayFormat>ADL-{00000000}</displayFormat>
        <label>Decision Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Approval Decision Logs</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>
