<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Amount__c</field>
        <field>Region__c</field>
        <field>Risk_Level__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Q_Credit_Risk</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>The Credit Risk queue. Any member decides, including a member through a public group.</description>
        <label>Credit Risk Review</label>
        <name>Credit_Risk_Review</name>
    </approvalStep>
    <description>One step on the Q_Credit_Risk queue, where the first member to act decides (arch doc 5.2, 5.4, M12). The queue is a step property, so another queue is another template (5.5).</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>Matrix_Submission__c = TRUE</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>AMF_Clear_Matrix_Submission</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>AMF_Clear_Matrix_Submission</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>PR Credit Risk Queue</label>
    <processOrder>3</processOrder>
    <recallActions>
        <action>
            <name>AMF_Clear_Matrix_Submission</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
