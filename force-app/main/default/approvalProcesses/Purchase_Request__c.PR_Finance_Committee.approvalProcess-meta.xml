<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Amount__c</field>
        <field>Region__c</field>
        <field>Risk_Level__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>amfu1@{{AMF_USERNAME_DOMAIN}}</name>
                <type>user</type>
            </approver>
            <approver>
                <name>amfu2@{{AMF_USERNAME_DOMAIN}}</name>
                <type>user</type>
            </approver>
            <approver>
                <name>amfu3@{{AMF_USERNAME_DOMAIN}}</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <description>The finance committee, G_Finance_Approvers&apos; members named as users: Classic cannot assign a public group. All three must approve.</description>
        <label>Finance Committee</label>
        <name>Finance_Committee</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>amfu4@{{AMF_USERNAME_DOMAIN}}</name>
                <type>user</type>
            </approver>
            <approver>
                <name>amfu5@{{AMF_USERNAME_DOMAIN}}</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Either finance leader. The first to respond decides. Terminal step.</description>
        <label>Finance Leadership</label>
        <name>Finance_Leadership</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>A committee, then a leader (arch doc 5.2, 5.4, M12): amfu1 to amfu3 unanimously, then amfu4 or amfu5, first response. Classic now; committees move to Flow only once its unanimous mode is known (12, item 1).</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>Matrix_Submission__c = TRUE</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>AMF_Clear_Matrix_Submission</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>AMF_Clear_Matrix_Submission</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>PR Finance Committee</label>
    <processOrder>4</processOrder>
    <recallActions>
        <action>
            <name>AMF_Clear_Matrix_Submission</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
