<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Flow approvals spike (M6), experiment 1: launch from Apex (Q1), record locking, final actions and the recall path (Q4). One approval step assigned to a named user, then a background stage that re-arms the guard; the ApprovalRecall path re-arms it too.</description>
    <environments>Default</environments>
    <interviewLabel>AMF Spike User {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AMF Spike User</label>
    <orchestratedStages>
        <name>Stage_Approve</name>
        <label>Approve</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Stage_Finalize</targetReference>
        </connector>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Approve_Request</name>
            <actionName>AMF_Spike_Approval_Screen</actionName>
            <actionType>stepApproval</actionType>
            <assignees>
                <assignee>
                    <stringValue>amfu1@amf.00daj000012gj9b.dev</stringValue>
                </assignee>
                <assigneeType>User</assigneeType>
            </assignees>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>ActionInput__RecordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <label>Approve Request</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <shouldLock>true</shouldLock>
            <stepSubtype>ApprovalStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Stage_Finalize</name>
        <label>Finalize</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Reset_Guard_On_Complete</name>
            <actionName>AMF_Spike_Reset_Guard</actionName>
            <actionType>stepBackground</actionType>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <label>Reset Guard On Complete</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <name>Stage_Recall</name>
        <label>Recall</label>
        <locationX>440</locationX>
        <locationY>134</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Reset_Guard_On_Recall</name>
            <actionName>AMF_Spike_Reset_Guard</actionName>
            <actionType>stepBackground</actionType>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <label>Reset Guard On Recall</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <processType>ApprovalWorkflow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stage_Approve</targetReference>
        </connector>
        <scheduledPaths>
            <name>Recall_Path</name>
            <connector>
                <targetReference>Stage_Recall</targetReference>
            </connector>
            <label>Recall</label>
            <pathType>ApprovalRecall</pathType>
        </scheduledPaths>
    </start>
    <status>Active</status>
    <variables>
        <name>firstApprover</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>submissionComments</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>submitter</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
