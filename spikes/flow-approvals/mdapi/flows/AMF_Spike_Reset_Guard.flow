<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Flow approvals spike (M6): background step that clears Matrix_Submission__c - the Flow counterpart of the Classic templates' final approval, final rejection and recall field updates that re-arm the guard (arch 5.2, 6.3).</description>
    <environments>Default</environments>
    <interviewLabel>AMF Spike Reset Guard {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AMF Spike Reset Guard</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Clear_Guard</name>
        <label>Clear Guard</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Matrix_Submission__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Purchase_Request__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Clear_Guard</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
