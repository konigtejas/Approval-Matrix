<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Probe_Direct</name>
        <label>Probe Direct</label>
        <locationX>440</locationX>
        <locationY>374</locationY>
        <defaultConnector>
            <targetReference>Stage_Direct_None</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Direct none</defaultConnectorLabel>
        <rules>
            <name>Direct_Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Approve_L1.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_Direct_Approve</targetReference>
            </connector>
            <label>Direct Approve</label>
        </rules>
        <rules>
            <name>Direct_Reject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Approve_L1.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_Direct_Reject</targetReference>
            </connector>
            <label>Direct Reject</label>
        </rules>
    </decisions>
    <decisions>
        <name>Probe_Mapped</name>
        <label>Probe Mapped</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <defaultConnector>
            <targetReference>Stage_Mapped_Other</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Mapped other</defaultConnectorLabel>
        <rules>
            <name>Mapped_Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>l1Decision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_Mapped_Approve</targetReference>
            </connector>
            <label>Mapped Approve</label>
        </rules>
        <rules>
            <name>Mapped_Reject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>l1Decision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_Mapped_Reject</targetReference>
            </connector>
            <label>Mapped Reject</label>
        </rules>
        <rules>
            <name>Mapped_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>l1Decision</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Probe_Direct</targetReference>
            </connector>
            <label>Mapped Null</label>
        </rules>
    </decisions>
    <description>Flow approvals spike (M6): reveals what an approval step's approvalDecision output holds when the decision arrives through reviewApprovalWorkItem rather than the screen flow. Each terminal stage's label names the path taken.</description>
    <environments>Default</environments>
    <interviewLabel>AMF Spike Output Probe {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AMF Spike Output Probe</label>
    <orchestratedStages>
        <name>Stage_L1</name>
        <label>Level 1</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Probe_Mapped</targetReference>
        </connector>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <name>Approve_L1</name>
            <actionName>AMF_Spike_Approval_Screen</actionName>
            <actionType>stepApproval</actionType>
            <assignees>
                <assignee>
                    <stringValue>amfu1@amf.00daj000012gj9b.dev</stringValue>
                </assignee>
                <assigneeType>User</assigneeType>
            </assignees>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>ActionInput__RecordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <label>Approve L1</label>
            <outputParameters>
                <assignToReference>l1Decision</assignToReference>
                <name>approvalDecision</name>
            </outputParameters>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <shouldLock>false</shouldLock>
            <stepSubtype>ApprovalStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
