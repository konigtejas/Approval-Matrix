    <description>Flow approvals spike (M6): the approver's screen for an approval step. Implements the contract of the standard "Approvals Workflow: Evaluate Approval Requests" template: outputs approvalDecision (Approve or Reject, exact spelling) and approvalComments.</description>
    <environments>Default</environments>
    <interviewLabel>AMF Spike Approval Screen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AMF Spike Approval Screen</label>
    <processType>Flow</processType>
    <screens>
